include ../mixins/sub-menu.pug

header.header
  .container
    .row
      .col-3
        .inner-logo
          a(href='/') 
            img(src='/images/logo', alt='')



      .col-5
        form(action="/search", method="GET")
          .form-group.d-flex.mb-0
            input.form-control(
              type="text"
              placeholder="Nhập từ khóa..."
              name="keyword"
              value= keyword
            )

            button.btn.btn-primary(
              type="submit"
            ) Tìm
      .col-4
        .inner-menu
          ul
            li
              a(href='/') Trang chủ
            li(class="sub-menu")
              -const pathProduct = "/products"
              a(href=pathProduct) Sản phẩm
                +sub-menu(layoutProductsCategory, pathProduct)
            li    
              a(href="#") Giỏ hàng (#{miniCart ?miniCart.totalQuantity:0})
