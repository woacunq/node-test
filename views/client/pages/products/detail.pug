extends ../../layouts/default.pug
include ../../mixins/alert.pug 

block main
  +alert-success(3000)
  .product-detail
    .container.my-5

      //- =========================
      //- BREADCRUMB
      //- =========================
      .product-breadcrumb
        a(href="/") Trang chủ
        span /
        span= product.title

      //- =========================
      //- THÔNG TIN SẢN PHẨM
      //- =========================
      .product-detail-card
        .row

          //- =========================
          //- ẢNH SẢN PHẨM
          //- =========================
          .col-lg-6
            .product-image-wrapper
              if product.thumbnail
                img.product-detail-image(
                  src=product.thumbnail
                  alt=product.title
                )
              else
                .product-no-image
                  | Không có hình ảnh

          //- =========================
          //- THÔNG TIN CHI TIẾT
          //- =========================
          .col-lg-6
            .product-detail-content

              //- Tên sản phẩm
              h1.product-detail-title= product.title

              //- Danh mục
              if product.product_category_id
                .product-category
                  span.category-label Danh mục:
                  a.category-name(
                    href=`/products/category/${product.product_category_id.slug}`
                  )= product.product_category_id.title

              //- Trạng thái
              .product-status
                if product.stock > 0
                  span.status-dot
                  span Còn hàng
                else
                  span.status-dot.out-of-stock
                  span Hết hàng

              //- Giá sản phẩm
              .product-price-box
                if product.priceNew
                  span.product-price-new
                    | #{product.priceNew}$

                  if product.discountPercentage
                    span.product-price-old
                      del #{product.price}$

                else if product.price
                  span.product-price-new
                    | #{product.price}$

              //- Phần trăm giảm giá
              if product.discountPercentage
                .product-discount
                  | -#{product.discountPercentage}% GIẢM

              //- Thông tin sản phẩm
              .product-info-list

                if product.stock != null
                  .product-info-item
                    span.label Số lượng:
                    span.value= product.stock

                if product.position != null
                  .product-info-item
                    span.label Vị trí:
                    span.value= product.position

                if product.discountPercentage
                  .product-info-item
                    span.label Tiết kiệm:
                    span.value
                      | #{product.price - product.priceNew}$

              //- =========================
              //- THÊM VÀO GIỎ HÀNG
              //- =========================
              .product-actions

                if product.stock > 0
                  form(
                    action=`/cart/add/${product.id}`
                    method="POST"
                  )
                    //- ID sản phẩm
                    input(
                      type="hidden"
                      name="productId"
                      value=product.id
                    )

                    //- Số lượng
                    .quantity-box
                      label(for="quantity") Số lượng:
                      input(
                        type="number"
                        id="quantity"
                        name="quantity"
                        value="1"
                        min="1"
                        max=product.stock
                      )

                    //- Nút thêm giỏ hàng
                    button.btn.btn-primary.btn-buy(
                      type="submit"
                    )
                      | Thêm vào giỏ hàng

                else
                  button.btn.btn-secondary.btn-buy(
                    type="button"
                    disabled
                  )
                    | Hết hàng

                //- Mua ngay
                button.btn.btn-outline-secondary.btn-buy-now(
                  type="button"
                )
                  | Mua ngay

          //- =========================
          //- MÔ TẢ SẢN PHẨM
          //- =========================
          .col-12
            .product-description-section

              h2.product-section-title
                | Mô tả sản phẩm

              if product.description
                .product-description
                  | !{product.description}
              else
                p.text-muted
                  | Chưa có mô tả cho sản phẩm này.