extends ../../layouts/default.pug

block main
  div #{cartDetail}
  .container.my-5
    h1.mb-4 Giỏ hàng

    table.table.table-bordered
      thead
        tr
          th STT
          th Ảnh
          th Tên
          th Giá
          th Số lượng
          th Tổng tiền
          th Hành động

      tbody
        each item, index in cartDetail.products
          tr
            td #{index+1}

            td
              img(
                src=`${item.product_id.thumbnail}`
                alt=`${item.product_id.title}`
                width="80"
              )

            td
              a(href=`/products/detail/${item.product_id.slug}`)
                | #{item.product_id.title}

            td
              | #{item.product_id.priceNew}

            td
              input(
                type="number"
                value= item.quantity
                min="1"
              )

            td
              | #{item.product_id.priceNew * item.quantity}

            td
              button.btn.btn-danger.btn-sm(
                type="button"
              )
                | Xóa

      

    //- Tổng đơn hàng
    .text-end.mt-4
      h3
        | Tổng đơn hàng: #{cartDetail.totalPrice}$

    //- Nút thanh toán
    .text-end.mt-3
      a.btn.btn-success(
        href="/checkout"
      )
        | THANH TOÁN