extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
    +alert-success(3000)
    +alert-error(3000)

    .container.my-5
        .row.justify-content-center
            .col-md-6.col-lg-5

                .card.shadow-sm
                    .card-header.text-center.py-3
                        h3.mb-0
                            | Đăng nhập

                    .card-body.p-4
                        form(
                            action="/user/login"
                            method="POST"
                        )

                            .mb-3
                                label.form-label(for="email")
                                    | Email

                                input.form-control(
                                    type="email"
                                    id="email"
                                    name="email"
                                    placeholder="Nhập email"
                                    required
                                )

                            .mb-3
                                label.form-label(for="password")
                                    | Mật khẩu

                                input.form-control(
                                    type="password"
                                    id="password"
                                    name="password"
                                    placeholder="Nhập mật khẩu"
                                    required
                                )

                            .mb-3.text-end
                                a(
                                    href="/user/password/forgot"
                                )
                                    | Quên mật khẩu?

                            button.btn.btn-primary.w-100(
                                type="submit"
                            )
                                | ĐĂNG NHẬP

                        .text-center.mt-4
                            span
                                | Bạn chưa có tài khoản?

                            a.ms-1(
                                href="/user/register"
                            )
                                | Đăng ký