extends ../../layouts/default.pug

include ../../mixins/alert.pug

block main
    +alert-success(3000)
    +alert-error(3000)

    .container.my-5
        .row.justify-content-center
            .col-md-6

                h1.text-center.mb-4 Đổi mật khẩu

                form(
                    action="/user/password/change?_method=PATCH"
                    method="POST"
                )

                    .mb-3
                        label.form-label(for="oldPassword")
                            | Mật khẩu hiện tại

                        input.form-control(
                            type="password"
                            id="oldPassword"
                            name="oldPassword"
                            required
                        )

                    .mb-3
                        label.form-label(for="newPassword")
                            | Mật khẩu mới

                        input.form-control(
                            type="password"
                            id="newPassword"
                            name="newPassword"
                            required
                        )

                    .mb-3
                        label.form-label(for="confirmPassword")
                            | Xác nhận mật khẩu mới

                        input.form-control(
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            required
                        )

                    button.btn.btn-primary.w-100(
                        type="submit"
                    )
                        | Đổi mật khẩu