extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug

block main
  +alert-error(5000)
  +alert-success(5000)
  h1 Chỉnh sửa danh mục sản phẩm

  form#form-edit-category(
    action=`${prefixAdmin}/products-category/edit/${record.id}?_method=PATCH`,
    method='POST',
    enctype='multipart/form-data'
  )
    //- Tiêu đề
    .form-group
      label(for='title') Tiêu đề
      input#title.form-control(
        type='text',
        name='title',
        required,
        value=`${record.title}`
      )

    //- Danh mục cha (parent_id)
    .form-group
      label(for="parent_id") Danh mục cha
      select#parent_id.form-control(name="parent_id")
        option(value="") -- Chọn danh mục cha --
        if records && records.length > 0
          +select-tree(records, 0, record.parent_id)

    //- Mô tả
    .form-group
      label(for='desc') Mô tả
      textarea#desc.form-control(
        name='description', 
        rows='5'
      ) #{ record.description }

    //- Ảnh đại diện
    .form-group(upload-image)
      label(for='thumbnail') Ảnh
      input#thumbnail.form-control-file(
        type='file',
        name='thumbnail',
        accept='image/*',
        upload-image-input
      )
      img#blah.image-preview(src=`${record.thumbnail}`, upload-image-preview) 
      .remove-image X

    //- Vị trí
    .form-group
      label(for='position') Vị trí
      input#position.form-control(
        type='number',
        name='position',
        placeholder='Tự động tăng',
        min='1',
        value=`${record.position}`
      )

    //- Trạng thái
    .form-group.mb-3
      label Trạng thái
      br
      .form-group.form-check.form-check-inline.mb-3
        input#statusActive.form-check-input(
          type='radio',
          name='status',
          value='active',
          checked=(record.status === 'active')
        )
        label.form-check-label(for='statusActive') Hoạt động

      .form-group.form-check.form-check-inline
        input#statusInActive.form-check-input(
          type='radio',
          name='status',
          value='inactive',
          checked=(record.status === 'inactive')
        )
        label.form-check-label(for='statusInActive') Dừng hoạt động

    .form-group
      button.btn.btn-primary(type='submit') Cập nhật


  script(src='/admin/js/product.js')