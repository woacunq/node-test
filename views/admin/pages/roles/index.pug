extends ../../layouts/default.pug

block main
  if role.permissions && role.permissions.includes("roles_view")
    
    h1(class="mb-4") Nhóm quyền

    .card.mb-3
      .card-header Danh sách
      .card-body
        .row.mb-3
          .col-8

          .col-4.text-right
            if role.permissions.includes("roles_create")
              a(
                href=`${prefixAdmin}/roles/create`
                class="btn btn-outline-success"
              ) + Thêm mới

        table(class="table table-hover table-sm")
          thead
            tr
              th STT
              th Nhóm quyền
              th Mô tả ngắn
              th Hành động

          tbody
            if(records.length > 0)
              each item, index in records
                tr
                  td #{index + 1}
                  td #{item.title}
                  td #{item.description}
                  td
                    if role.permissions.includes("roles_edit")
                      a(
                        href=`${prefixAdmin}/roles/edit/${item._id}`
                        class="btn btn-warning btn-sm mr-1"
                      ) Sửa
                    if role.permissions.includes("roles_delete")
                      a(
                        href=`${prefixAdmin}/roles/delete/${item._id}`
                        class="btn btn-danger btn-sm"
                      ) Xóa
            else
              tr
                td(colspan="4" class="text-center")
                  | Chưa có nhóm quyền nào.

  else
    //- Giao diện khi không có quyền xem
    .card.shadow-sm
      .card-body.text-center.py-5
        h4.mb-3 Không có quyền truy cập
        p.text-muted.mb-0
          | Bạn không có quyền xem danh sách nhóm quyền.