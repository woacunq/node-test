extends ../../layouts/default.pug

block main
  
  if role.permissions && role.permissions.includes("roles_create")
    
    h1(class="mb-4") Thêm mới nhóm quyền

    form(
      action=`${prefixAdmin}/roles/create`
      method="POST"
    )
      .form-group
        label(for="title") Tiêu đề
        input(
          type="text"
          class="form-control"
          id="title"
          name="title"
          required
        )

      .form-group.my-3 
        label(for="desc") Mô tả
        input(
          type="text"
          class="form-control"
          id="desc"
          name="description"
        )

      .form-group
        button(
          type="submit"
          class="btn btn-primary"
        ) Tạo mới

  else
    //- Giao diện khi không có quyền
    .card.shadow-sm
      .card-body.text-center.py-5
        h4.mb-3 Không có quyền truy cập
        p.text-muted.mb-0
          | Bạn không có quyền thêm mới nhóm quyền.