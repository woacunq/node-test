extends ../../layouts/default.pug

block main
  if product.title
    h1.mb-4 #{product.title}

  if product.product_category_id
    .mb-4
      span Danh mục: 
      b #{product.product_category_id.title ? product.product_category_id.title : product.product_category_id}

  if product.price
    .mb-4
      span Giá: 
      b #{product.price}$

  if product.discountPercentage
    .mb-4
      span Giảm giá: 
      b #{product.discountPercentage}%

  if product.stock
    .mb-4
      span Còn lại: 
      b #{product.stock}

  if product.thumbnail
    .mb-4
      img(
        src=product.thumbnail
        alt=product.title
        style='width: 150px; height: auto; border-radius: 5px; object-fit: cover;'
      )

  if product.status
    .mb-4
      span Trạng thái: 
      if product.status === 'active'
        span.badge.bg-success Hoạt động
      else
        span.badge.bg-danger Dừng hoạt động

  if product.position
    .mb-4
      span Vị trí: 
      b #{product.position}

  if product.description
    .mb-4 
      span <b>Mô tả sản phẩm:</b>
      div.mt-2 !{product.description}

  hr

  a.btn.btn-warning.me-2(
    href=`${prefixAdmin}/products/edit/${product._id}`
  ) Chỉnh sửa sản phẩm
  
  a.btn.btn-secondary(
    href=`${prefixAdmin}/products`
  ) Quay lại danh sách

  script(src='/admin/js/product.js')