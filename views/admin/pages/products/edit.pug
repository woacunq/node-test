extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug


block main
  +alert-error(5000)
  +alert-success(5000)

  if role.permissions && role.permissions.includes("products_edit")

    h1 Chỉnh sửa sản phẩm

    form#form-edit-product(
      action=`${prefixAdmin}/products/edit/${product.id}?_method=PATCH`,
      method='POST',
      enctype='multipart/form-data'
    )
      //- Tiêu đề
      .form-group
        label(for='title') Tiêu đề
        input#title.form-control(
          type='text',
          name='title',
          required,
          value=`${product.title}`
        )

      //- Mô tả
      .form-group
        label(for='desc') Mô tả
        textarea#desc.textarea-mce.form-control(
          name='description',
          rows='5'
        ) #{ product.description }

      //- Danh mục
      .form-group
        label(for="product_category_id") Danh mục sản phẩm

        select#product_category_id.form-control(
          name="product_category_id"
        )
          option(value="") -- Chọn danh mục --

          if categories && categories.length > 0
            - const currentCategoryId = product.product_category_id ? product.product_category_id.toString() : ""
            +select-tree(categories, 0, currentCategoryId)
      //- Sản phẩm nổi bật
      .form-group
        label Sản phẩm nổi bật

        br

        .form-check.form-check-inline
          input#featuredYes.form-check-input(
            type="radio",
            name="featured",
            value="true",
            checked=(product.featured=="true"? true: false)
          )

          label.form-check-label(for="featuredYes")
            | Có

        .form-check.form-check-inline
          input#featuredNo.form-check-input(
            type="radio",
            name="featured",
            value="false",
            checked=(product.featured=="false"? true: false)
          )

          label.form-check-label(for="featuredNo")
            | Không
      //- Giá
      .form-group
        label(for='price') Giá

        input#price.form-control(
          type='number',
          name='price',
          value=`${product.price}`,
          min='0'
        )

      //- % Giảm giá
      .form-group
        label(for='discountPercentage') % Giảm giá

        input#discountPercentage.form-control(
          type='number',
          name='discountPercentage',
          value='0',
          min='0'
        )

      //- Số lượng
      .form-group
        label(for='stock') Số lượng

        input#stock.form-control(
          type='number',
          name='stock',
          value=`${product.stock}`,
          min='0'
        )

      //- Ảnh
      .form-group(upload-image)
        label(for='thumbnail') Ảnh

        input#thumbnail.form-control-file(
          type='file',
          name='thumbnail',
          accept='image/*',
          upload-image-input
        )

        img#blah.image-preview(
          src=`${product.thumbnail}`,
          upload-image-preview
        )

        .remove-image X

      //- Vị trí
      .form-group
        label(for='position') Vị trí

        input#position.form-control(
          type='number',
          name='position',
          placeholder='Tự động tăng',
          min='1',
          value=`${product.position}`
        )

      //- Trạng thái
      .form-group.mb-3
        label Trạng thái

      br

      .form-group.form-check.form-check-inline.mb-3
        input#statusActive.form-check-input(
          type='radio',
          name='status',
          value='active',
          checked=product.status === 'active'
        )

        label.form-check-label(for='statusActive')
          | Hoạt động

      .form-group.form-check.form-check-inline
        input#statusInActive.form-check-input(
          type='radio',
          name='status',
          value='inactive',
          checked=product.status === 'inactive'
        )

        label.form-check-label(for='statusInActive')
          | Dừng hoạt động

      .form-group
        button.btn.btn-primary(type='submit') Lưu

    script(src='/admin/js/product.js')

  else

    .card.shadow-sm
      .card-body.text-center.py-5
        h4.mb-3 Không có quyền truy cập

        p.text-muted
          | Bạn không có quyền chỉnh sửa sản phẩm.