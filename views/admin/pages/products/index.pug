extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/alert.pug
include ../../mixins/sort.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  if role.permissions && role.permissions.includes("products_view")

    h1 Danh sách sản phẩm

    //- Bộ lọc và tìm kiếm
    .card.mb-3
      .card-header Bộ lọc và Tìm kiếm
      .card-body
        .row
          .col-6
            +filter-status(filterStatus)

          .col-6
            +search(keyword)

    //- Sắp xếp
    .card.mb-3 
      .card-header Sắp xếp
      .card-body
        .row
          .col-4
            +sort

    //- Danh sách sản phẩm
    .card.mb-3
      .card-header Danh sách sản phẩm

      .card-body
        .row
          .col-8
            +form-change-multi(`${prefixAdmin}/products/change-multi?_method=PATCH`)

          //- Chỉ hiển thị nút Thêm mới nếu có quyền products_create
          .col-4.text-end
            if role.permissions.includes("products_create")
              a.btn.btn-outline-success(
                href=`${prefixAdmin}/products/create`
              ) + Thêm mới

      table.table.table-hover.table-sm(checkbox-multi)
        thead
          tr
            th
              input(
                type='checkbox',
                name='checkall'
              )
            th STT
            th Hình ảnh
            th Tiêu đề
            th Giá
            th Vị trí
            th Trạng thái
            th Hành động

        tbody
          each item, index in products
            tr
              td
                input(
                  type='checkbox',
                  name='id',
                  value=item.id
                )

              td #{ pagination.limitItems * (pagination.currentPage - 1) + (index + 1) }

              td
                img(
                  src=item.thumbnail,
                  alt=item.title,
                  width='100px',
                  height='auto'
                )

              td #{ item.title }

              td #{ item.price }

              td
                input(
                  type='number',
                  value=item.position,
                  style='width: 60px',
                  min='1',
                  name='position'
                )

              td 
                if role.permissions.includes("products_edit")
                  if item.status === 'active'
                    a.btn.btn-success.text-nowrap(
                      href='javascript:;',
                      data-status=item.status,
                      data-id=item._id,
                      button-change-status,
                      style='width: 140px'
                    ) Hoạt động
                  else
                    a.btn.btn-danger.text-nowrap(
                      href='javascript:;',
                      data-status=item.status,
                      data-id=item._id,
                      button-change-status,
                      style='width: 140px'
                    ) Dừng hoạt động
                else
                  if item.status === 'active'
                    span.btn.btn-success.text-nowrap(
                      style='width: 140px'
                    ) Hoạt động
                  else
                    span.btn.btn-danger.text-nowrap(
                      style='width: 140px'
                    ) Dừng hoạt động
              td
                //- Chi tiết
                a.btn.bg-secondary.text-black.p-1(
                  href=`${prefixAdmin}/products/detail/${item.id}`
                ) Chi tiết

                //- Chỉnh sửa
                if role.permissions.includes("products_edit")
                  a.btn.bg-warning.text-black.p-1.mx-1(
                    href=`${prefixAdmin}/products/edit/${item.id}`
                  ) Sửa

                //- Xóa
                if role.permissions.includes("products_delete")
                  button.btn.btn-danger.btn-sm(
                    data-id=item.id,
                    button-delete
                  ) Xóa

    +pagination(pagination)

    //- Form đổi trạng thái
    form#form-change-status(
      action='',
      method='POST',
      data-path=`${prefixAdmin}/products/change-status`
    )

    //- Form xóa
    form#form-delete-item(
      action='',
      method='POST',
      data-path=`${prefixAdmin}/products/delete`
    )

    script(src='/admin/js/product.js')

  else

    //- Không có quyền xem sản phẩm
    .card.shadow-sm
      .card-body.text-center.py-5
        h4.mb-3 Không có quyền truy cập

        p.text-muted.mb-0
          | Bạn không có quyền xem danh sách sản phẩm.