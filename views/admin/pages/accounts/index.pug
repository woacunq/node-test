extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  if role.permissions && role.permissions.includes("accounts_view")

    h1(class="mb-4") Danh sách tài khoản

    .card.mb-3
      .card-header
        | Danh sách tài khoản

      .card-body
        .row.mb-3
          .col-8

          .col-4.text-right
            if role.permissions.includes("accounts_create")
              a.btn.btn-outline-success(
                href=`${prefixAdmin}/accounts/create`
              ) + Thêm mới

        if records && records.length > 0

          .table-responsive
            table.table.table-hover.table-bordered
              thead
                tr
                  th STT
                  th Avatar
                  th Họ tên
                  th Email
                  th Số điện thoại
                  th Vai trò
                  th Trạng thái
                  th Hành động

              tbody
                each item, index in records
                  tr
                    td= index + 1

                    td
                      if item.avatar
                        img(
                          src=item.avatar
                          alt=item.fullName
                          width="50"
                          height="50"
                          style="object-fit: cover; border-radius: 50%;"
                        )
                      else
                        | Chưa có

                    td= item.fullName

                    td= item.email

                    td= item.phone || "-"

                    td
                      if item.role_id
                        if item.role_id.title
                          = item.role_id.title
                        else
                          = item.role_id
                      else
                        | Chưa phân quyền

                    td
                      if item.status == "active"
                        span.bg-success Hoạt động
                      else
                        span.bg-danger Dừng hoạt động

                    td
                      if role.permissions.includes("accounts_edit")
                        a.btn.btn-warning.btn-sm(
                          href=`${prefixAdmin}/accounts/edit/${item.id}`
                        ) Sửa

                      if role.permissions.includes("accounts_delete")
                        a.btn.btn-danger.btn-sm.ml-2(
                          href=`${prefixAdmin}/accounts/delete/${item.id}`
                        ) Xóa

        else
          .alert.alert-info
            | Chưa có tài khoản nào.

  else
    .card.shadow-sm
      .card-body.text-center.py-5
        h4.mb-3 Không có quyền truy cập

        p.text-muted.mb-0
          | Bạn không có quyền xem danh sách tài khoản.