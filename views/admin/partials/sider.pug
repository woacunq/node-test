.sider
  .inner-menu
    ul
      //- Dashboard
      li
        a(href=`${prefixAdmin}/dashboard`) Dashboard

      //- Sản phẩm
      if role.permissions.includes("products_view")
        li
          a(href=`${prefixAdmin}/products`) Products

      //- Danh mục sản phẩm
      if role.permissions.includes("products-category_view")
        li
          a(href=`${prefixAdmin}/products-category`) Categories

      //- Nhóm quyền
      if role.permissions.includes("roles_view")
        li
          a(href=`${prefixAdmin}/roles`) Roles

      //- Phân quyền
      if role.permissions.includes("roles_permissions")
        li
          a(href=`${prefixAdmin}/roles/permissions`) Permissions

      //- Tài khoản
      if role.permissions.includes("accounts_view")
        li
          a(href=`${prefixAdmin}/accounts`) Accounts