      .main
        block main

    script(
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js'
    )
    //- Tinymce
    script(src='/tinymce/tinymce.min.js')
    script(src='/admin/js/tinymce-config.js')
